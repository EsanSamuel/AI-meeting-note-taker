# Server
SERVER_PORT=8080
SERVER_ENV=development

# Database (PostgreSQL + pgvector)
# DB_URL takes precedence over individual connection parameters if provided.
DB_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=postgres
DB_SSL_MODE=disable

# Cache / Queue (Defined in config schema; unused in current runtime)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage
RECORDINGS_DIR=./recordings
MAX_RECORDING_BYTES=104857600

# Speech / Diarization
HF_TOKEN=hf_your_huggingface_token
ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# AI / LLM
GEMINI_API_KEY=your_gemini_api_key

# Logging / Telemetry
SENSORY_API_KEY=your_sensory_api_key
