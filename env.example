# ==============================================================================
# AI Note Taker - Environment Configuration Example
# Copy this file to '.env' in the project root and fill in your actual credentials.
#   cp env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port on which the Go HTTP API backend server will listen (Default: 8080)
SERVER_PORT=8080

# Application environment: 'development', 'staging', or 'production' (Default: development)
SERVER_ENV=development

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# Primary Connection URL (takes precedence if set).
# Supported formats: postgres://user:password@host:port/dbname?sslmode=disable
# Note: For Supabase or Neon, make sure connection pooling or direct port is used.
DB_URL=postgresql://postgres:postgres@localhost:5432/ai_note_taker?sslmode=disable

# Fallback individual DB parameters (used only if DB_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=ai_note_taker
DB_SSL_MODE=disable

# ------------------------------------------------------------------------------
# 3. Redis Configuration (Optional / Caching & Queues)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Storage & Upload Settings
# ------------------------------------------------------------------------------
# Directory where raw uploaded recording files (.webm, .mp4, etc.) are temporarily saved
RECORDINGS_DIR=./recordings

# Maximum permitted recording upload file size in bytes (Default: 104857600 = 100 MiB)
MAX_RECORDING_BYTES=104857600

# ------------------------------------------------------------------------------
# 5. AI & External Services API Keys
# ------------------------------------------------------------------------------
# Hugging Face Access Token (REQUIRED for speaker diarization)
# Must have accepted user conditions for the gated model:
# https://huggingface.co/pyannote/speaker-diarization-3.1
# and https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_your_huggingface_token_here

# Google Gemini API Key (REQUIRED for LLM meeting summarization & RAG Q&A)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Sensory Logging API Key (OPTIONAL)
# Used by the internal logger client for centralized telemetry.
# If omitted or invalid, the logger safely falls back to NoOp.
SENSORY_API_KEY=your_sensory_api_key_here

# AssemblyAI API Key (OPTIONAL / Alternative Speech-to-Text)
# Used when calling the cloud-based speech-to-text integration.
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ------------------------------------------------------------------------------
# 6. Desktop Client (Wails Frontend) Configuration
# ------------------------------------------------------------------------------
# Note: The desktop client (desktop/client/frontend) defaults to 'http://localhost:8080'.
# You can override this within the app UI or via localStorage key: 'afterword.apiBaseUrl'.
